# ═══════════════════════════════════════════════════════════════════════════
#  BSS PROMO LCD — ENVIRONMENT  (2026-08-29)
#  Taruh file ini di ROOT project Next.js sebagai .env.local
#  Di Vercel: Settings → Environment Variables → paste satu per satu (Production)
#  JANGAN commit ke Git. Pastikan .gitignore memuat .env*
# ═══════════════════════════════════════════════════════════════════════════

# ── Database (Neon) ────────────────────────────────────────────────────────
# Ambil dari Neon Console → Project → Connection Details.
# DATABASE_URL          = connection string POOLED   (ada "-pooler" di host)
# DATABASE_URL_UNPOOLED = connection string DIRECT   (tanpa "-pooler"), utk drizzle-kit migrate
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# ── Midtrans (PRODUCTION — merchant G528691836) ────────────────────────────
MIDTRANS_MERCHANT_ID=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="true"
MIDTRANS_API_BASE="https://api.midtrans.com"
MIDTRANS_SNAP_BASE="https://app.midtrans.com/snap/v1"
# Webhook khusus transaksi aplikasi ini. Dikirim per transaksi lewat header
# X-Override-Notification, jadi kolom "Payment Notification URL" di dashboard
# Midtrans TIDAK perlu diubah — punya proyek lain (tuser.id) tetap aman.
# Kosongkan kalau akun Midtrans-nya kelak dipakai aplikasi ini saja.
MIDTRANS_NOTIFICATION_URL="https://promolcd.site/api/webhooks/midtrans"

# Client key WAJIB berprefiks NEXT_PUBLIC_ supaya terbaca snap.js di browser.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_SNAP_URL="https://app.midtrans.com/snap/snap.js"

# ── QR & voucher (HMAC-SHA256, dibagi dengan standby.php di cPanel) ────────
# QR_SIGNING_SECRET harus PERSIS SAMA dengan PROMO_QR_SECRET di standby.php.
QR_KEY_ID="k1"
QR_SIGNING_SECRET=""
# Menandatangani tautan gambar voucher: /v/{code}?t={token}
VOUCHER_URL_SECRET=""
VOUCHER_VALID_DAYS="30"

# ── API untuk standby.php (arah cPanel → Vercel) ───────────────────────────
# CS_API_SECRET harus PERSIS SAMA dengan PROMO_API_SECRET di standby.php.
# sha256(CS_API_SECRET) sudah tersimpan di tabel api_clients Neon:
#   a39727bb88efd0758c5d0f718545269e64212e8530156fa845d54ae71c3832cb
CS_API_CLIENT_KEY="php-cs-01"
CS_API_SECRET=""
# Isi dengan IP publik server cPanel (cek: ping mybss.cloud). Kosongkan utk nonaktif.
CS_API_ALLOWED_IPS=""

# ── Bridge ke MySQL cPanel (arah Vercel → cPanel, lookup nomor lama) ───────
# Secret ini dipakai bss-bridge/lookup.php. Belum dibuat? Biarkan, alur tetap
# jalan: gagal lookup = pelanggan mengisi nama/alamat manual.
BSS_BRIDGE_URL="https://mybss.cloud/bss-bridge/lookup.php"
BSS_BRIDGE_KEY="prod-vercel-01"
BSS_BRIDGE_SECRET=""
BSS_BRIDGE_TIMEOUT_MS="3000"

# ── Keamanan ───────────────────────────────────────────────────────────────
AUTH_SECRET=""
PHONE_HASH_PEPPER=""
# Menandatangani tautan cetak-ulang voucher yang diterbitkan CS (sekali pakai).
REISSUE_TOKEN_SECRET=""
CRON_SECRET=""

# ── Rate limit (Upstash Redis) — isi setelah membuat database di upstash.com ─
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Anti-bot (Cloudflare Turnstile) — isi setelah daftar di dash.cloudflare.com ─
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ── Umum ───────────────────────────────────────────────────────────────────
# Domain produksi. Dipakai untuk menyusun tautan voucher permanen dan
# alamat balik dari Midtrans, jadi harus persis sama dengan domain yang
# dipasang di Vercel — termasuk ada/tidaknya "www".
NEXT_PUBLIC_BASE_URL="https://promolcd.site"
NEXT_PUBLIC_STORE_NAME="BSS Service"
NEXT_PUBLIC_CS_WHATSAPP=""
TZ="Asia/Jakarta"   # WIB — sama dengan config.php back office (Lumajang, Jatim)

# ═══════════════════════════════════════════════════════════════════════════
#  CATATAN CETAK ULANG VOUCHER
#  Vercel tidak bisa menjalankan Baileys (butuh proses hidup terus + simpan
#  sesi; Vercel serverless mati setiap request selesai). Jadi TIDAK ADA kirim
#  ulang otomatis lewat WhatsApp. Pelanggan yang kehilangan gambar voucher
#  wajib menghubungi CS. CS membuka /admin/voucher, mengetik nomor HP yang
#  disebutkan pelanggan; sistem mencocokkan dengan phone_snapshot klaim, lalu
#  menerbitkan tautan sekali pakai (umur pendek) yang dicatat di tabel
#  voucher_reissues. Setiap penerbitan ulang tercatat siapa dan kapan.
# ═══════════════════════════════════════════════════════════════════════════
